rules_version = '2';

/* =====================================================================
   배드민턴 대진판 — Firestore 보안 규칙

   전제: 이 앱은 익명 로그인만 쓴다. 그래서 규칙은 "누가" 요청했는지
   구분할 수 없다(아무나 익명 계정을 만들 수 있다). 대신 "무엇을" 쓰는지는
   강하게 조인다 — 경로·문서 이름 화이트리스트, 저장 형식과 크기 검증,
   삭제 전면 금지, 그리고 회원 명단이 통째로 비워지는 쓰기 차단.

   ── 운영자 비밀번호를 어떻게 숨기는가 ─────────────────────────────
   예전에는 settings 문서 안에 adminPin이 평문으로 들어 있었다. settings는
   누구나 읽을 수 있으므로 비밀번호가 아니라 공지사항이었다.

   이제는 세 조각으로 나눈다.

     kv/adminAuth      { salt, iter }   ← 읽기 허용. salt는 비밀이 아니다.
     secret/adminPin   { hash }         ← 읽기 금지. 아무도 못 가져간다.
     probe/{랜덤}      { hash }         ← 읽기 금지. 규칙이 비교만 해 준다.

   확인 절차는 "읽어서 비교"가 아니라 "써 보고 되는지 본다"이다.
   앱이 입력한 비밀번호로 PBKDF2 해시를 만들어 probe 문서 생성을 시도하면,
   규칙이 secret/adminPin의 hash와 대조해 같을 때만 허용한다.
     · 생성 성공      → 비밀번호가 맞다
     · permission-denied → 틀렸다
   비밀번호도 해시도 클라이언트로 내려가지 않는다. 네트워크를 뜯어봐도,
   config 파일을 복사해 스크립트를 돌려도 마찬가지다. 얻을 수 있는 것은
   "맞다/틀리다" 한 비트뿐이다.

   ── 최초 설정과 초기화 ──────────────────────────────────────────
   secret/adminPin은 kv/adminAuth가 "없을 때만" 만들 수 있다. 그래서
     · DB가 비어 있으면(최초 접속) 앱이 최초 비밀번호를 받아 둘을 함께 만든다.
     · 한 번 설정되면 앱에서는 절대 못 바꾼다(덮어쓰기·삭제 모두 금지).
     · 초기화는 콘솔에서 kv/adminAuth 문서 하나만 지우면 된다. 그 순간
       다시 "미설정" 상태가 되어 앱이 새 비밀번호를 받는다.

   ⚠ 알고 쓸 것
     · 지운 직후~새로 설정하기 전까지는 앱을 먼저 연 사람이 비밀번호를
       차지한다. 지웠으면 곧바로 본인이 설정할 것.
     · 온라인 무차별 대입(초당 수십 번 probe를 두드리는 것)은 규칙으로
       막지 못한다. 콘솔에서 App Check를 켜고, 4자리 숫자 말고 길게 쓸 것.
     · 회원 명단 읽기는 여전히 막지 못한다. 익명 로그인을 켜 둔 이상
       규칙으로는 안 된다. 명단 프라이버시가 필요하면 실제 로그인이 필요하다.

   ⚠ 이 파일을 고쳐도 그것만으로는 적용되지 않는다. 호스팅 워크플로는
      호스팅만 올린다. 규칙은 따로 배포해야 한다:
        firebase deploy --only firestore:rules
   ===================================================================== */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    /* ── 비밀번호는 두 종류다 ───────────────────────────────────────
       운영자(admin)와 소유자(owner). 저장 구조는 완전히 같고 이름만 다르다.
         kv/adminAuth  ↔ secret/adminPin
         kv/ownerAuth  ↔ secret/ownerPin
       소유자 비밀번호를 따로 두는 이유는 §운영자 비밀번호 주석 아래에 적었다. */
    function authDocFor(kind) { return kind == 'owner' ? 'ownerAuth' : 'adminAuth'; }
    function pinDocFor(kind)  { return kind == 'owner' ? 'ownerPin'  : 'adminPin';  }
    function kindOfPin(pinDoc){ return pinDoc == 'ownerPin' ? 'owner' : 'admin'; }

    function authPath(club, kind) {
      return /databases/$(database)/documents/clubs/$(club)/kv/$(authDocFor(kind));
    }
    function pinPath(club, kind) {
      return /databases/$(database)/documents/clubs/$(club)/secret/$(pinDocFor(kind));
    }

    /* ── 등록된 동호회만 ────────────────────────────────────────────
       예전에는 주소창에 아무 이름이나 치면 그 이름의 빈 동호회가 생겼다.
       먼저 연 사람이 운영자 비밀번호까지 차지했다. 이제 등록 표시
       문서(meta/club)가 있어야만 읽고 쓸 수 있다.

       그 문서는 클라이언트가 만들 수 없다(아래 meta 블록 참고). 신규
       동호회는 신청을 받아 서버가 만들어 준다.

       'default'는 이 구조가 생기기 전부터 쓰던 동호회라 예외로 둔다.
       meta 문서를 만들어 주면 이 예외는 지워도 된다. */
    function registered(club) {
      return club == 'default'
          || exists(/databases/$(database)/documents/clubs/$(club)/meta/club);
    }

    // ── 동호회 등록 표시 ────────────────────────────────────────────
    // 누구나 읽을 수 있다(존재 여부를 알아야 앱이 안내를 띄운다).
    // 쓰기는 아무에게도 열려 있지 않다 — 관리자 SDK(서버·콘솔)만 만든다.
    match /clubs/{club}/meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    /* ── 역할 — 실제 계정으로 들어온 소유자·운영자 ──────────────────
       clubs/{club}/roles/{uid} = { role: 'owner' | 'admin' }

       익명 로그인만 쓰던 동안에는 규칙이 "누가" 요청했는지 알 수 없었다.
       그래서 소유자와 운영자의 구분이 앱 안에서만 유효했고, 운영자
       비밀번호를 아는 사람이 앱을 거치지 않으면 그 구분을 통과했다.
       이 문서가 그 구분을 DB 수준으로 옮기는 첫 조각이다.

       읽기는 본인 것만 연다. 남의 역할까지 훑어보게 두면 이 동호회의
       운영자가 누구누구인지 목록으로 긁어 갈 수 있다.

       쓰기는 아직 아무에게도 열지 않는다. 첫 소유자는 콘솔에서 심어야
       한다(닭과 달걀 — 소유자가 없으면 소유자를 임명할 사람도 없다).
       앱에서 운영자를 추가하는 길은 이 구조가 자리 잡은 뒤에 연다. */
    match /clubs/{club}/roles/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    /* ── 전체 동호회 정원 ───────────────────────────────────────────
       캡차가 준비되기 전까지는 "전체 몇 개까지"가 남용 방지 장치다.
         registry/clubs = { count, limit }
       앱은 이 값을 읽어 "정원이 찼습니다"를 보여 준다. 쓰기는 서버만 —
       지금은 개설 자체가 수동(콘솔)이므로 개설할 때 count를 함께 올린다.
       Functions가 생기면 트랜잭션으로 읽고-올리고-만들기를 한 번에 한다. */
    match /registry/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── 평범한 앱 데이터 ────────────────────────────────────────────
    match /clubs/{club}/kv/{docId} {

      // 앱이 실제로 만드는 문서 이름만 허용한다.
      function knownDoc() {
        return docId in ['settings', 'members', 'sessions', 'adminLeases',
                         'adminAuth', 'ownerAuth', 'joinRequests']
            || docId.matches('session:[0-9]{4}-[0-9]{2}-[0-9]{2}');
      }

      // 저장 형식은 { v: JSON 문자열, updatedAt: 타임스탬프 }.
      // 운영자 임차권(adminLeases)은 트랜잭션에서 updatedAt 없이 쓰므로
      // updatedAt을 필수로 걸면 운영자 입장이 막힌다. hasOnly로만 조인다.
      function validShape() {
        return request.resource.data.keys().hasOnly(['v', 'updatedAt'])
            && request.resource.data.v is string
            && request.resource.data.v.size() < 900000;   // 문서 1MiB 한도 안쪽
      }

      // 회원 명단이 통째로 비워지는 쓰기는 서버에서도 막는다.
      // 빈 배열은 "[]" 두 글자다. 멀쩡한 명단이 들어 있는데 그런 값이
      // 올라오면 사고다 — 오프라인에서 돌아올 때 나던 바로 그 사고이고,
      // 앱 쪽 잠금(actions.js의 save)이 뚫렸을 때의 마지막 방어선이다.
      // 한 명만 남기는 것은 막지 않는다(빈 값일 때만 걸린다). 정말로 명단을
      // 0명으로 만들어야 한다면 앱에서는 안 되고, Firebase 콘솔에서 직접
      // 고치거나 이 규칙을 잠시 풀었다가 되돌려야 한다. 일부러 그렇게 뒀다.
      function notWipingMembers() {
        return !(docId == 'members'
                 && request.resource.data.v.size() < 10
                 && resource.data.v.size() > 100);
      }

      /* salt 문서(adminAuth·ownerAuth)는 최초 설정 때 한 번만 만들어진다.
         앱에서 고치거나 지울 수 없다 — 그래야 남이 salt를 갈아끼워
         비밀번호를 무력화하는 짓을 못 한다. 초기화는 콘솔에서만. */
      function saltDocOk() {
        return !(docId in ['adminAuth', 'ownerAuth'])
            || !exists(/databases/$(database)/documents/clubs/$(club)/kv/$(docId));
      }

      allow read:   if signedIn() && registered(club) && knownDoc();
      allow create: if signedIn() && registered(club) && knownDoc()
                    && validShape() && saltDocOk();
      allow update: if signedIn() && registered(club) && knownDoc() && validShape()
                    && notWipingMembers() && saltDocOk();
      allow delete: if false;      // 앱은 어떤 문서도 지우지 않는다
    }

    // ── 비밀번호 해시 — 읽기 금지 ───────────────────────────────────
    match /clubs/{club}/secret/{docId} {
      allow read: if false;                    // 예외 없다. 아무도 못 읽는다.

      /* kv/adminAuth가 없을 때(=미설정)만 쓸 수 있다. 설정된 뒤에는
         만들 수도, 덮어쓸 수도 없다.

         update까지 같은 조건으로 허용하는 것이 중요하다. 초기화는 콘솔에서
         kv/adminAuth만 지우는 방식인데, 그때 secret/adminPin 문서는 그대로
         남아 있다. 새 비밀번호를 쓰는 것은 create가 아니라 update다.
         update를 막아 두면 초기화한 순간 아무도 다시 설정할 수 없게 되어
         영영 로그인 불가가 된다 — 규칙 테스트가 바로 이걸 잡아냈다. */
      allow create, update: if signedIn()
                    && registered(club)
                    && docId in ['adminPin', 'ownerPin']
                    && !exists(authPath(club, kindOfPin(docId)))
                    && request.resource.data.keys().hasOnly(['hash'])
                    && request.resource.data.hash is string
                    && request.resource.data.hash.size() == 64;   // SHA-256 hex
      allow delete: if false;
    }

    // ── 비밀번호 확인용 임시 문서 ───────────────────────────────────
    // 해시가 맞을 때만 생성이 허용된다. 앱은 이 성공/실패로만 판정한다.
    // 읽을 수는 없으므로 여기에 쓴 해시가 다시 새어 나가지도 않는다.
    match /clubs/{club}/probe/{probeId} {
      allow read: if false;
      allow create: if signedIn()
                    && registered(club)
                    && request.resource.data.keys().hasOnly(['hash', 'kind'])
                    && request.resource.data.kind in ['admin', 'owner']
                    && request.resource.data.hash is string
                    && exists(pinPath(club, request.resource.data.kind))
                    && request.resource.data.hash
                       == get(pinPath(club, request.resource.data.kind)).data.hash;
      allow update: if false;
      allow delete: if signedIn();   // 확인이 끝나면 앱이 스스로 치운다
    }
  }
}
